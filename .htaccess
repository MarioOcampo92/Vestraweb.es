RewriteEngine On

# Redirect old WordPress blog articles to blog listing (SEO: 301 preserves link equity)
Redirect 301 /disenador-web-freelance-castellon /blog
Redirect 301 /para-que-sirve-una-pagina-web /blog
Redirect 301 /cuanto-cuesta-una-pagina-web-en-tarragona /blog
Redirect 301 /diseno-paginas-web-tarragona /blog
Redirect 301 /posicionamiento-web-tarragona /blog
Redirect 301 /tecnologias-mas-demandadas /blog
Redirect 301 /tienda-online-tarragona /blog

# Redirect old WordPress page slugs to new static pages
Redirect 301 /proyectos/ /portafolio.html
Redirect 301 /portfolio/ /portafolio.html
Redirect 301 /contacto/ /contactar.html

# Remove .html extension for cleaner URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]

# Cache expiration for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|webm|mp4|css|js|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
